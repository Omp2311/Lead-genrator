# Copy to .env and fill in. NEVER commit .env.
DATABASE_URL=postgresql://outreachpilot:CHANGE_ME@localhost:5432/outreachpilot
# 64+ random hex chars:  python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=
# Fernet key for encrypting stored mailbox credentials (recommended in production):
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# If unset, a key is derived from JWT_SECRET (rotating JWT_SECRET then breaks stored credentials).
ENCRYPTION_KEY=
# https:// here turns on production mode (Secure cookies, strict checks)
FRONTEND_URL=http://localhost:3000
EXTRA_CORS_ORIGINS=
BACKEND_URL=http://localhost:8000
# Admin seed (password must be 12+ chars)
ADMIN_EMAIL=
ADMIN_PASSWORD=
OPENAI_API_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=
